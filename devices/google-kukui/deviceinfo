# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Google Kukui Chromebook"
deviceinfo_manufacturer="Google"
deviceinfo_codename="google-kukui"
deviceinfo_year="2019"
deviceinfo_dtb="mediatek/mt8183-kukui*"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="convertible"
deviceinfo_external_storage="true"
deviceinfo_drm="true"
deviceinfo_disable_dhcpd="true"

# Bootloader related
deviceinfo_cgpt_kpart="/boot/vmlinuz.kpart"
deviceinfo_cgpt_kpart_start="8192"
# 128M kernel partition
deviceinfo_cgpt_kpart_size="262144"
# The "mt8183" depthcharge board covers the whole MT8183 ChromeOS family
# (kukui, krane, kodama, kakadu, katsu, and jacuzzi variants) because
# depthcharge matches root DT compatible "mediatek,mt8183" while make-kpart.sh
# packages only the DTBs matched by deviceinfo_dtb.
deviceinfo_depthcharge_board="mt8183"
deviceinfo_depthcharge_compression="lz4"
deviceinfo_generate_depthcharge_image="true"

deviceinfo_boot_type="depthcharge"
deviceinfo_boot_size_mib="512"
deviceinfo_boot_filesystem="ext2"
deviceinfo_image_size_mib="6144"
# mmc0 (11230000.mmc) is internal eMMC (/dev/mmcblk0) and mmc1 (11240000.mmc)
# is the microSD slot (/dev/mmcblk1); installer defaults to internal eMMC
# unless running from it.
deviceinfo_install_target="/dev/mmcblk0"
