# Hayato mainline arm64 base kernel configuration fragment.
# Merged via scripts/kconfig/merge_config.sh with architecture defconfig +
# board/SoC fragments from kernels/arm64-mainline/fragments/*.config.
#
# Invariants checked by core/scripts/check-system.sh & OS design:
#   - 1000 Hz tick + preemptible desktop responsiveness
#   - Multi-Gen LRU (MGLRU) enabled at boot for 4-8 GB zram devices
#   - schedutil default cpufreq governor + kyber I/O scheduler
#   - zram + lz4/zstd compression + transparent hugepages (madvise)
#   - systemd cgroup v2 / namespaces / PSI requirements

CONFIG_LOCALVERSION="-hayato"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Timing, preemption & power/CPUfreq
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_DEBUG=y

# Memory management, zram & I/O scheduling
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_MQ_IOSCHED_KYBER=y

# systemd & container/sandbox primitives
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PSI=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FANOTIFY=y
CONFIG_DMIID=y

# EFI / EBBR & bootloader interoperability
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=m
CONFIG_OF=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Filesystems & encryption
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_DM_CRYPT=y

# Networking & VPN
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_WIREGUARD=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m

# Display, Wayland VT & USB/I2C HID input
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID=y
CONFIG_I2C_HID_OF=m
CONFIG_TYPEC=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_SND_SOC=y
